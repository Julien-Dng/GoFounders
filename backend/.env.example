# Copier en .env (dans backend/ ou à la racine du projet) puis remplir. Ne jamais versionner le fichier .env.
# Les deux emplacements sont lus ; backend/.env l'emporte sur ../.env en cas de doublon.

# Fournisseur d'IA : une seule clé suffit. OpenAI est utilisé en priorité si sa clé est présente.
openAIkey=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Projet Supabase : Settings > API
SUPABASE_URL=https://votre-projet.supabase.co
# Clé service_role : secrète, uniquement côté serveur (jamais dans l'appli Angular)
SUPABASE_SERVICE_ROLE_KEY=...

# Origines autorisées à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:4200

# Optionnel
# OPENAI_MODEL=gpt-6.1-sol
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# MAX_REQUESTS_PER_HOUR=30
